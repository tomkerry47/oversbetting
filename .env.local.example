NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
RAPIDAPI_KEY=your-rapidapi-key-here
USE_RAPIDAPI=true

# GitHub fixture refreshes keep enrichment off by default to avoid extra API calls.
# Set true only if you want form/table/odds data refreshed for every fixture.
ENRICH_FIXTURES=false

# Set to 'true' to use Chromium-based requests (bypasses 403 errors but slower)
USE_BROWSER_API=false

# When RAPIDAPI_KEY is set the app automatically uses the SofaScore RapidAPI
# (sofascore.p.rapidapi.com).  Set to 'false' to force the unofficial SofaScore
# API even when a key is present.
# USE_RAPIDAPI=false
